# FirmScout local environment configuration.
#
# Copy this file to `.env` (in this same directory, infrastructure/docker/)
# and adjust as needed:
#
#   cp infrastructure/docker/.env.example infrastructure/docker/.env
#
# `.env` is gitignored (see the repo root .gitignore); `.env.example` is not,
# and is the documentation of record for every variable docker-compose.yml
# consumes. Every value below is an obviously-fake local development
# default -- NONE of these are real secrets, and none should ever be. This
# file describes the *local Compose* environment only; production
# configuration lives in AWS Secrets Manager / SSM Parameter Store per
# docs/architecture/security.md, never in a committed .env file.

# ---------------------------------------------------------------------------
# PostgreSQL (the `postgres` service)
# ---------------------------------------------------------------------------

# Superuser/app role used by every service that talks to the database
# locally. In production this is a scoped application role, not a superuser
# -- the local Compose setup uses one role for simplicity, matching
# blueprint's "identical stack locally and on AWS" principle at the level of
# behavior, not at the level of least-privilege database roles (that's a
# production-hardening concern out of scope for local dev).
POSTGRES_USER=firmscout
POSTGRES_PASSWORD=firmscout-dev-only-not-a-real-secret
POSTGRES_DB=firmscout

# Host port Postgres is published on, so a contributor can point a local
# `psql` or GUI client at it. Container-internal port is always 5432.
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# firmscout-api (the `api` service)
# ---------------------------------------------------------------------------

# Host port the API is published on. Container-internal port is always 8080
# (docs/architecture/api.md's documented port for /healthz and /api/v1/*).
API_PORT=8080

# ---------------------------------------------------------------------------
# firmscout-web (the `web` service)
# ---------------------------------------------------------------------------

# Host port the Next.js site is published on. Container-internal port is
# always 3000.
WEB_PORT=3000

# ---------------------------------------------------------------------------
# Build metadata
# ---------------------------------------------------------------------------

# Embedded into every Go binary as `main.version` (see go.Dockerfile) and
# into OTel resource attributes as `service.version`. Set this to a real
# commit SHA in CI; "dev" is fine for a local build.
FIRMSCOUT_VERSION=dev

# Stamped as the `deployment.environment.name` resource attribute on every
# span/metric/log (see docs/architecture/observability.md §3) and used by
# the Collector's `resource` processor. Always "local" for this Compose
# file; "staging"/"production" are AWS-only values.
FIRMSCOUT_ENV=local

# Go's own structured logger level (slog). One of: debug, info, warn, error.
# See docs/architecture/observability.md §6 for when to use each level.
FIRMSCOUT_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Grafana (the `grafana` service -- only started with --profile observability)
# ---------------------------------------------------------------------------

# Local-only admin credentials for the provisioned Grafana instance. Change
# these if you expose Grafana beyond localhost for any reason, which is not
# a supported or recommended configuration for this Compose file.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=firmscout-dev-only-not-a-real-secret

# Host port Grafana's UI is published on.
GRAFANA_PORT=3001

# ---------------------------------------------------------------------------
# Other observability-profile host ports (defaults rarely need changing;
# only relevant if another local process already holds one of these ports)
# ---------------------------------------------------------------------------

PROMETHEUS_PORT=9090
LOKI_PORT=3100
TEMPO_HTTP_PORT=3200
TEMPO_OTLP_GRPC_PORT=4319
OTEL_COLLECTOR_GRPC_PORT=4317
OTEL_COLLECTOR_HTTP_PORT=4318
OTEL_COLLECTOR_METRICS_PORT=8888
OTEL_COLLECTOR_APP_METRICS_PORT=8889
