{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firmscout.dev/schemas/product.schema.json",
  "title": "FirmScout product registry entry",
  "description": "An exact model, or a software product with an independently released version stream.",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "firmscout.dev/v1alpha1"
    },
    "kind": {
      "const": "Product"
    },
    "metadata": {
      "type": "object",
      "required": [
        "slug",
        "vendor"
      ],
      "additionalProperties": false,
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 128,
          "description": "Globally unique public identifier, immutable after creation. Conventionally `<vendor>-<model>`."
        },
        "vendor": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "family": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        }
      }
    },
    "spec": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "model_identifier": {
          "type": "string",
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 4000
        },
        "default_release_type": {
          "enum": [
            "firmware",
            "bios",
            "bmc_firmware",
            "driver",
            "operating_system",
            "embedded_os",
            "application_software",
            "saas_release",
            "management_platform",
            "security_update",
            "advisory",
            "documentation_only",
            "unknown"
          ],
          "description": "The kind of release this product normally publishes. Labelling everything firmware is the failure this field prevents: a server has BIOS, BMC firmware, drivers and an appliance OS, and a user searching for one does not want the others."
        },
        "lifecycle_status": {
          "enum": [
            "active",
            "maintenance",
            "eol_announced",
            "eol",
            "eos",
            "unknown"
          ],
          "default": "unknown",
          "description": "Most vendors publish no firmware-lifecycle statement at all, so an omitted line defaults to \"unknown\" rather than asserting \"active\" -- a claim the absence of a line does not support."
        },
        "security_critical": {
          "type": "boolean",
          "default": false
        },
        "popularity_score": {
          "type": "integer",
          "minimum": 0
        },
        "category_slugs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        },
        "aliases": {
          "type": "array",
          "description": "Other names this product is known by. Aliases drive search and product matching, so a common misspelling is as useful here as an official model number.",
          "items": {
            "type": "object",
            "required": [
              "alias"
            ],
            "additionalProperties": false,
            "properties": {
              "alias": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "kind": {
                "enum": [
                  "marketing_name",
                  "model_number",
                  "sku",
                  "regional_name",
                  "legacy_name",
                  "vendor_internal",
                  "common_misspelling"
                ],
                "default": "marketing_name"
              },
              "source_note": {
                "type": "string",
                "maxLength": 1000
              }
            }
          }
        },
        "runs": {
          "type": "array",
          "description": "Products this product runs, most usefully the operating system a hardware model runs. This is a navigation edge -- 'the firmware for this box is published over there' -- and explicitly not an applicability claim: which release of that product applies to this exact model is a separate question this list does not answer.",
          "items": {
            "type": "object",
            "required": [
              "product"
            ],
            "additionalProperties": false,
            "properties": {
              "product": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                "description": "The registry slug of the product this one runs. It must exist in the registry; a slug that does not fails the sync with an error naming this file."
              },
              "kind": {
                "enum": [
                  "runs_os"
                ],
                "default": "runs_os"
              },
              "source_note": {
                "type": "string",
                "maxLength": 1000,
                "description": "Where this assertion came from: the URL fetched, when it was fetched, and the excerpt that says it."
              }
            }
          }
        }
      }
    }
  }
}
